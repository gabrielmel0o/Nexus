# Configuração do backend NEXUS
# Chave da API do Gemini (obtida gratuitamente em aistudio.google.com)
GEMINI_API_KEY=cole_sua_chave_aqui

# Nome do modelo oficial Gemini 3
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_RESERVA=

# Porta do servidor HTTP local
PORT=3000

# Modo simulado: 1 = devolve a Helena sem chamar a API (não gasta cota); 0 = chama o Gemini
MODO_SIMULADO=1
